# このファイルをコピーして .env を作成し、実際の値を設定する。
# cp .env.example .env
# .env は .gitignore 済みのため、実際の値をコミットしないこと。

# Django
SECRET_KEY=change-me

# データベース（開発・本番共通のキー名。docker-compose.yml の変数展開にも使われる）
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# 以下は開発環境では通常デフォルト値のままでよい（development.py 側にデフォルト値あり）
# DB_HOST=127.0.0.1
# DB_PORT=3306

# 以下は本番（production.py）専用。ローカル開発では不要
# ALLOWED_HOSTS=example.com,www.example.com
# DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# Google OAuth（django-allauth、基本設計書 6.4節）
GOOGLE_OAUTH_CLIENT_ID=change-me
GOOGLE_OAUTH_CLIENT_SECRET=change-me

# セッションタイムアウト（秒）。未設定時は1800秒（30分）
# SESSION_TIMEOUT_SECONDS=1800

# Gmail API（メール取込・通知、基本設計書6.1節）。ログイン用OAuthクライアントとは別に作成する
GMAIL_API_CLIENT_ID=change-me
GMAIL_API_CLIENT_SECRET=change-me
GMAIL_API_REFRESH_TOKEN=change-me

# 通知メール送信先（要件6.5.1）
NOTIFICATION_RECIPIENT_EMAIL=change-me

# メール取込バッチで登録する取引の登録者（基本設計書6.2節）
MAIL_IMPORT_USER_EMAIL=change-me
